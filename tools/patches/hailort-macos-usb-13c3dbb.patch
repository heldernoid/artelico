diff --git a/hailort/cmake/external/libusb.cmake b/hailort/cmake/external/libusb.cmake
index 842b73e..711aece 100644
--- a/hailort/cmake/external/libusb.cmake
+++ b/hailort/cmake/external/libusb.cmake
@@ -1,5 +1,10 @@
 cmake_minimum_required(VERSION 3.5.0)
 
-# using pkgconfig because libusb does not provide a CMake configuration file
-find_package(PkgConfig REQUIRED)
-pkg_check_modules(LIBUSB REQUIRED IMPORTED_TARGET libusb-1.0)
+# Local change: no pkg-config needed; point straight at Homebrew's libusb (Apple Silicon path)
+# instead of using find_package(PkgConfig).
+if(NOT TARGET PkgConfig::LIBUSB)
+    add_library(PkgConfig::LIBUSB INTERFACE IMPORTED GLOBAL)
+    set_target_properties(PkgConfig::LIBUSB PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "/opt/homebrew/opt/libusb/include/libusb-1.0"
+        INTERFACE_LINK_LIBRARIES "/opt/homebrew/opt/libusb/lib/libusb-1.0.dylib")
+endif()
